{
  "name": "cafebox-backend",
  "version": "2.0.0",
  "private": true,
  "description": "CafeBox — backend: servicio central y seguridad. Suscripciones de café con entregas recurrentes.",
  "type": "module",
  "engines": { "node": ">=20" },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "tsx watch src/main.ts",
    "preparar": "npm run migrar && npm run sembrar",
    "migrar": "prisma migrate deploy",
    "sembrar": "tsx scripts/sembrar.ts",
    "bd:reiniciar": "prisma migrate reset --force",
    "bd:estudio": "prisma studio",
    "build": "prisma generate && tsc",
    "start": "node dist/src/main.js",
    "verificar": "tsc --noEmit",
    "prueba:reglas": "tsx scripts/probarReglas.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.19.1",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/swagger-ui-express": "^4.1.6",
    "prisma": "^5.19.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
